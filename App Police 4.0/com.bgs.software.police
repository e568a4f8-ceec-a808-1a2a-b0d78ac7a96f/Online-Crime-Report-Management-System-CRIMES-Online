<script>
  (function($) {
    $(function() {
      const $langTool = $(".cc-lang-tool.btn");
      const $langBtn = $langTool.find(".cc-lang-label:not(.cc-dropdown-btn)");
      const $langText = $langTool.find(".cc-lang-text");
      const $langLink = $langTool.find(".cc-lang-item > .item-href");

      let isMobile = utils.isMobile() || window.innerWidth <= 640;
      const $win = $(window);
      const $document = $(document);
      const $body = $("body");
      let currentLangLabel = "English";
      let currentLangValue = "EN";
      const langToolType = "btn";

      initLangTool();

      function initLangTool() {
        bindEvent();
        $body.toggleClass("cc-mobile", isMobile);
      }

      function bindEvent() {
        langResizeEvent();
        updateLangText();
        languageClicksLocal();
        bindLangChangeEvent();
        $win.on("resize", function() {
          langResizeEvent();
          updateLangText();
        });
      }

      function updateLangText() {
        console.log(currentLangLabel,currentLangValue,langToolType);
        if (langToolType === "select") {
          $langText.text(currentLangLabel);
          return;
        }
        if (langToolType === "box") {
          $langText.text(currentLangValue);
          return;
        }
        if ($langTool.hasClass("mobile") && window.innerWidth <= 1180) {
          $langText.text(currentLangLabel);
          return;
        }
        $langText.text(currentLangValue);
      }

      function bindLangChangeEvent() {
        window.removeEventListener('h5-lang-change', handleLangChange);
        window.addEventListener('h5-lang-change', handleLangChange);
      }

      function handleLangChange(event) {
        const detail = event && event.detail ? event.detail : {};
        const langPath = detail.langPath || utils.parseWebsiteLang({
          target: 'path',
          langValue: detail.lang || localStorage.getItem('h5_user_lang'),
        }) || 'en';

        currentLangLabel = utils.parseWebsiteLang({
          target: 'label',
          langPath: langPath,
        }) || currentLangLabel;
        currentLangValue = langPath.replace('_', '-').toUpperCase() || currentLangValue;
        updateLangText();
      }

      function langResizeEvent() {
        isMobile = utils.isMobile() || window.innerWidth <= 640;
        $body.toggleClass("cc-mobile", isMobile);
        $langTool.toggleClass("mobile", isMobile);

        if (isMobile && $langTool.attr("data-event") !== "me") {
          bindMobileEvent();
        }

        if (!isMobile && $langTool.attr("data-event") === "me") {
          removeMobileEvent();
        }
      }

      function bindMobileEvent() {
        $langTool.attr("data-event", "me");
        $langBtn.on("click", function() {
          $langTool.toggleClass("open");
        });
        $document.on("click", closeLangMenu);
      }

      function removeMobileEvent() {
        $langTool.attr("data-event", "");
        $langBtn.off("click", function() {
          $langTool.toggleClass("open");
        });
        $document.off("click", closeLangMenu);
      }

      function closeLangMenu(event) {
        if (!event.target.closest(".cc-lang-tool")) {
          $langTool.removeClass("open");
        }
      }

      function languageClicksLocal() {
        $langLink.on("click", function(e) {
                      e.preventDefault();
                    const targetHref = $(this).attr('href') || window.location.href;
          const lang = $(this).parent().attr('data-lang');
          const langValue = utils.parseWebsiteLang({
            target: 'value',
            langPath: lang,
          }) || 'en';
          localStorage.setItem('h5_user_lang', langValue);
          if (typeof dataLayerFun != 'undefined' && dataLayerFun.languageClicks) {
            dataLayerFun.languageClicks(lang);
          }
          // 设置cookie
          document.cookie = "hf_basic_lang_name=" + lang + "; path=/";
                      window.location.reload();
                            });
      }

      // $win.on('unload', function() {
      //   $win.off("resize", function () {
      //     langResizeEvent();
      //     updateLangText();
      //   });

      //   $document.off("click", closeLangMenu);
      // });
    })
  })(window.jQuery)
</script>        </li>
              </ul>
