	<link rel="stylesheet" type="text/css" href="/center/exploring/basic/css/basic.other.min.css?18487c03229cbbd28195b6c8d597301d" />
	<script>
		// basic 多语言页局部修补 hf_i18n（不修改 hf_i18n.js 源文件）
		(function () {
			function applyBasicI18nPatch() {
				if (typeof hf_i18n === 'undefined' || hf_i18n.__basicI18nPatched) {
					return typeof hf_i18n !== 'undefined';
				}
				hf_i18n.__basicI18nPatched = true;
				var basicLang = typeof window.laji_basic_lang !== 'undefined' ? window.laji_basic_lang : 'en';
				if (!basicLang || basicLang === 'en') {
					return true;
				}
				var preloadLang = basicLang.toLowerCase();
				if (preloadLang === 'zh_cn' || preloadLang === 'zh_tw') {
					preloadLang = preloadLang.replace('_', '-');
				}
				var langOrigin = location.origin.indexOf('fliphtml5.com') !== -1 ? location.origin : 'https://fliphtml5.com';
				var basicOtherLangUrl = langOrigin + '/multi/languages/center/exploring/basic/js/basic.other.min_' + preloadLang + '.js';
				var basicContactLangUrl = langOrigin + '/multi/languages/center/exploring/basic/js/basic.contact.min_' + preloadLang + '.js';
				var origGetCallerPath = hf_i18n.getCallerPath;
				var origGettext = hf_i18n._gettext;
				hf_i18n.getCallerPath = function (lang) {
					var path = origGetCallerPath.call(this, lang);
					if (path) {
						return path;
					}
					var stack = '';
					try {
						stack = new Error().stack || '';
					} catch (e) {}
					if (stack.indexOf('basic.other') !== -1) {
						return basicOtherLangUrl;
					}
					if (stack.indexOf('basic.contact') !== -1) {
						return basicContactLangUrl;
					}
					return '';
				};
				hf_i18n._gettext = function (text) {
					var lang = hf_i18n.getLang();
					if (lang === 'en') {
						return text;
					}
					var script_href = hf_i18n.getCallerPath(lang);
					if (!script_href) {
						return text;
					}
					return origGettext.call(hf_i18n, text);
				};
				hf_i18n.loadFileUlr(basicOtherLangUrl);
				hf_i18n.loadFileUlr(basicContactLangUrl);
				return true;
			}
			if (!applyBasicI18nPatch()) {
				var patchTimer = setInterval(function () {
					if (applyBasicI18nPatch()) {
						clearInterval(patchTimer);
					}
				}, 50);
				setTimeout(function () {
					clearInterval(patchTimer);
				}, 5000);
			}
		})();
	</script>
